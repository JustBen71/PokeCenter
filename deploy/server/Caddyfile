{$PUBLIC_DOMAIN::80} {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api:3000
  }
  handle /rooms/* {
    reverse_proxy api:3000
  }
  handle /socket.io/* {
    reverse_proxy api:3000
  }
  # Launchers: force a download instead of opening the file in the tab; a missing file is a 404, never the site's HTML.
  handle /downloads/* {
    header /downloads/Pokerace-* Content-Disposition attachment
    root * /srv
    file_server
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy same-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
