{$PUBLIC_DOMAIN::80} {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api:3000
  }
  handle /socket.io/* {
    reverse_proxy api:3000
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy same-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
